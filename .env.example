# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI Whisper API (STT)
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=sqlite:///./yuljae_data.db

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Audio Storage
AUDIO_STORAGE_PATH=./audio_files
MAX_AUDIO_SIZE_MB=100

# Analysis Settings
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_ANALYSIS_MAX_TOKENS=4096
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ko

# Business Settings
COMPANY_NAME=율재부동산
MIN_OPPORTUNITY_SCORE=60
# 부동산 영업 데이터 자산화 시스템 환경 설정

# 앱 설정
APP_NAME=부동산 영업 데이터 자산화 시스템
APP_VERSION=1.0.0
DEBUG=false

# 데이터베이스
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/yuljae_realestate

# STT 설정
WHISPER_MODEL=large-v3
AUDIO_SAMPLE_RATE=16000

# 분석 설정
TRIGGER_WORD_THRESHOLD=0.7
SENTIMENT_MODEL=klue/bert-base

# API 설정
API_HOST=0.0.0.0
API_PORT=8000

# 저장 경로 (선택사항)
# DATA_BASE_PATH=./data
# UPLOAD_DIR=./uploads
# TRANSCRIPT_DIR=./transcripts
# AssemblyAI API Key (STT + Speaker Diarization)
# Get your key at: https://www.assemblyai.com/
# $50 free credits on signup
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Anthropic API Key (Analysis Engine)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# Google Drive & Sheets 자동화 파이프라인 설정
# ===========================================

# 서비스 계정 JSON 키 파일 경로
# 설정 방법: GOOGLE_DRIVE_SETUP.md 참고
GOOGLE_SERVICE_ACCOUNT_PATH=credentials.json

# 처리 대기(To-Do) 폴더 ID
# 구글 드라이브 폴더 URL에서 추출: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_TODO_FOLDER_ID=your_todo_folder_id_here

# 처리 완료(Done) 폴더 ID
GOOGLE_DRIVE_DONE_FOLDER_ID=your_done_folder_id_here

# 마스터 관리대장 스프레드시트 ID
# 스프레드시트 URL에서 추출: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# 데이터를 기록할 시트(탭) 이름 (기본값: 상담기록)
GOOGLE_SHEETS_SHEET_NAME=상담기록
